{
  "name": "growen-frontend-vue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:nginx": "node tools/generate-nginx-routes.mjs",
    "predev": "npm run generate:nginx",
    "dev": "vite --host --port 5176",
    "typecheck": "vue-tsc -b",
    "prebuild": "npm run generate:nginx",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host --port 5176",
    "test": "vitest --run",
    "test:e2e": "node tools/run-e2e.mjs"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "axios": "^1.18.1",
    "pinia": "^3.0.4",
    "vue": "^3.5.39",
    "vue-router": "^4.6.4",
    "vuetify": "^3.12.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^27.2.0",
    "sass": "^1.101.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.5",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.7"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
