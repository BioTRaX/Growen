# NG-HEADER: Nombre de archivo: .env.example
# NG-HEADER: Ubicación: frontend-vue/.env.example
# NG-HEADER: Descripción: Variables públicas para API, release y timeouts del frontend Vue.
# NG-HEADER: Lineamientos: Ver AGENTS.md
VITE_API_BASE_URL=/api
VITE_API_TARGET=http://127.0.0.1:8000
VITE_RELEASE=local
VITE_REQUEST_TIMEOUT_MS=30000

# Compatibilidad temporal. Preferir VITE_API_BASE_URL y VITE_API_TARGET.
# VITE_API_URL=http://127.0.0.1:8000
