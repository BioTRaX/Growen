# NG-HEADER: Nombre de archivo: production.conf.template
# NG-HEADER: Ubicación: infra/nginx/production.conf.template
# NG-HEADER: Descripción: Terminación TLS LAN y proxy restringido para producción.
# NG-HEADER: Lineamientos: Ver AGENTS.md

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    server_name ${GROWEN_LAN_HOST};
    return 308 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name ${GROWEN_LAN_HOST};
    root /usr/share/nginx/html;
    client_max_body_size ${NGINX_CLIENT_MAX_BODY_SIZE};

    ssl_certificate /run/secrets/lan_tls_cert;
    ssl_certificate_key /run/secrets/lan_tls_key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;

    include /etc/nginx/security-headers.conf;

    location = /health {
        proxy_pass http://api:8000/health;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }

    location ^~ /api/ {
        proxy_pass http://api:8000/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
        proxy_cache off;
    }

    location ^~ /media/ {
        proxy_pass http://api:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }

    location ^~ /vue-assets/ {
        try_files $uri =404;
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location = /vue/index.html {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    include /etc/nginx/generated-spa-routes.conf;

    location / {
        try_files $uri $uri/ /index.html;
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }
}
