# =========================
# Growen - .gitignore
# =========================

# Entornos y dependencias
.venv/
env/
venv/
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/
pip-wheel-metadata/

# Archivos de configuración local
.env
.env.*
!.env.example
.envrc
.direnv/
*.local.env
config.local.*
credentials.local.*
secrets.local.*

# Credenciales y llaves
*.pem
*.key
*.crt
*.pfx
*.p12
*.jks
*.keystore
*.secret
*.secrets
# Carpeta de certificados y credenciales
certs/
credentials/
secrets/

# Logs y temporales
*.log
*.log.*
logs/
tmp/
temp/
*.tmp
*.bak
*.swp
.DS_Store

# Bases locales
*.sqlite
*.db
*.db-journal

# Alembic caches
alembic/versions/*.pyc
alembic/versions/__pycache__/

# Cache y pruebas
.cache/
.pytest_cache/
pytestdebug.log

# IDEs
.vscode/
.idea/
*.iml

# Frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
frontend/dist/
frontend/.vite/
frontend-vue/dist/
frontend-vue/.vite/
frontend-vue/test-results/
frontend-vue/playwright-report/
frontend/tsconfig.tsbuildinfo
*.tsbuildinfo

# Docker
docker-compose.override.yml
.docker/
**/.docker/

# Datos de ejemplo
data/*
*.csv
*.xlsx
*.json
!data/README.md
!frontend/package.json
!frontend/package-lock.json
!frontend/tsconfig.json
!frontend/.env.development
!frontend-vue/package.json
!frontend-vue/package-lock.json
!frontend-vue/tsconfig.json
!frontend-vue/config/modules.json
!docs/rag/corpus-manifest.v1.json

# Backups
backup/
backups/
*.bak
*.old
*.orig

# Scripts locales con credenciales o parámetros sensibles (usar *.example.ps1)
scripts/pg_migrate_15_to_17.ps1
scripts/*.local.ps1

# Media (archivos subidos y derivados)
backup/
backups/
*.bak
*.old
*.orig

# Scripts locales con credenciales o parámetros sensibles (usar *.example.ps1)
scripts/pg_migrate_15_to_17.ps1
scripts/*.local.ps1
scratch/
infra/cloudflare/*.json.local
**/cloudflare_meli_tunnel_token
**/meli_app_id
**/meli_client_secret
**/meli_token_encryption_key

# Media (archivos subidos y derivados)
Imagenes/
Productos/

# Carpeta de desarrollo y pruebas locales
Devs/

# Carpeta de conocimientos (documentos PDF que no deben estar en el repositorio)
Conocimientos/

# Widgets locales de SiYuan
siyuan-widgets/*
!siyuan-widgets/crono/
!siyuan-widgets/crono/**
